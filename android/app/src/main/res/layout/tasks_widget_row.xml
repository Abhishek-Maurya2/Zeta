<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_task_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="60dp"
    android:orientation="horizontal"
    android:paddingTop="9dp"
    android:paddingBottom="9dp">

    <FrameLayout
        android:id="@+id/widget_checkbox_touch"
        android:layout_width="40dp"
        android:layout_height="48dp"
        android:clickable="true"
        android:contentDescription="Complete task"
        android:focusable="true">

        <ImageView
            android:id="@+id/widget_checkbox"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:contentDescription=""
            android:src="@drawable/widget_checkbox_outline" />

        <TextView
            android:id="@+id/widget_checkbox_check"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:gravity="center"
            android:text="✓"
            android:textColor="#FF381E72"
            android:textSize="16sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingEnd="0dp">

        <TextView
            android:id="@+id/widget_task_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans"
            android:maxLines="1"
            android:textColor="#FFFFFFFF"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/widget_task_due"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans"
            android:maxLines="1"
            android:paddingTop="3dp"
            android:textColor="#DFFFFFFF"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
